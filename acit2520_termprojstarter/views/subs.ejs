<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Subgroups</title>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@picocss/pico@1/css/pico.classless.min.css"
    />
    <link href="/css/style.css" rel="stylesheet" />
  </head>
  <body>
    <main>
      <div class="authOptions">
        <h1>All Subgroups</h1>
        <a role="button" href="/posts">Home</a>
      </div>

      <% if (subs && subs.length > 0) { %>
        <ul>
          <% subs.forEach(sub => { %>
            <li>
              <a href="/subs/show/<%= sub.name %>">
                <strong><%= sub.name %></strong>
              </a> 
              ( <%= sub.count %> posts )
            </li>
          <% }) %>
        </ul>
      <% } else { %>
        <p>No subgroups found.</p>
      <% } %>
    </main>
  </body>
</html>
