<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Homepage</title>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@picocss/pico@1/css/pico.classless.min.css"
    />
    <link href="/css/style.css" rel="stylesheet" />
  </head>
  <body>
    <main>
      <div class="authOptions">
        <h1>All Posts</h1>
        <% if (!user) { %>
          <a role="button" href="/auth/login">Login</a>
        <% } else { %>
          <a role="button" href="/auth/logout">Logout</a>
        <% } %>
      </div>

      <h2>Welcome, <%= user?.uname || "Visitor" %>.</h2>

      <div>
        <% if (posts && posts.length > 0) { %>
          <% posts.forEach(post => { %>
            <article class="individualPost">
              <a href="/posts/show/<%= post.id %>">
                <h3><%= post.title %></h3>
              </a>
              <p><%= post.description %></p>
              <p><strong>Subgroup:</strong> <%= post.subgroup %></p>
              <p><strong>Posted by:</strong> <%= post.creator.uname %></p>
            </article>
          <% }) %>
        <% } else { %>
          <p>No posts found.</p>
        <% } %>
      </div>

      <hr />

      <div>
        <a href="/subs/list">Subgroups</a>
      </div>

      <% if (user) { %>
        <div>
          <a role="button" href="/posts/create">Create Post</a>
        </div>
      <% } %>
    </main>
  </body>
</html>
