<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title><%= post.title %></title>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@picocss/pico@1/css/pico.classless.min.css"
    />
    <link href="/css/style.css" rel="stylesheet" />
  </head>
  <body>
    <main>
      <div class="authOptions">
        <h1><%= post.title %></h1>
        <a role="button" href="/posts">Back to All Posts</a>
      </div>

      <article>
        <% if (post.link) { %>
          <h2>
            <a href="<%= post.link %>" target="_blank">
              <%= post.link %>
            </a>
          </h2>
        <% } %>
        <p><%= post.description %></p>
        <p><strong>Subgroup:</strong> <%= post.subgroup %></p>
        <p><strong>Posted by:</strong> <%= post.creator.uname %></p>
        <p><strong>Votes:</strong> <%= post.votes.length %></p>

        <% if (user && user.id === post.creator.id) { %>
          <p>
            <a href="/posts/edit/<%= post.id %>">Edit</a> |
            <a href="/posts/deleteconfirm/<%= post.id %>">Delete</a>
          </p>
        <% } %>
      </article>

      <section>
        <h3>Comments (<%= post.comments.length %>)</h3>
        <% if (post.comments.length === 0) { %>
          <p>No comments yet.</p>
        <% } else { %>
          <ul>
            <% post.comments.forEach(comment => { %>
              <li>
                <strong><%= comment.creator.uname %></strong>:
                <%= comment.description %>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </section>

      <% if (user) { %>
        <form action="/posts/comment-create/<%= post.id %>" method="POST">
          <label for="description">Add a comment:</label>
          <textarea name="description" required></textarea>
          <button type="submit">Comment</button>
        </form>
      <% } else { %>
        <p><a href="/auth/login">Login</a> to comment.</p>
      <% } %>
    </main>
  </body>
</html>