<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Create Post</title>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@picocss/pico@1/css/pico.classless.min.css"
    />
    <link href="/css/style.css" rel="stylesheet" />
  </head>
  <body>
    <main>
      <div class="authOptions">
        <h1>Create Post</h1>
        <a role="button" href="/posts">Home</a>
      </div>

      <form action="/posts/create" method="POST">
        <label>
          Title:
          <input type="text" name="title" placeholder="Enter a title" required />
        </label>

        <label>
          Description:
          <textarea
            name="description"
            placeholder="Enter a description"
            required
          ></textarea>
        </label>
        
        <label>
          Link (optional):
          <input type="text" name="link" placeholder="Enter a link" />
        </label>

        <label>
          Subgroup:
          <input
            type="text"
            name="subgroup"
            placeholder="Enter a subgroup name"
            required
          />
        </label>

        <button type="submit">Submit Post</button>
      </form>
    </main>
  </body>
</html>