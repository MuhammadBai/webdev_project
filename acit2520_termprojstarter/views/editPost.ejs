<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Edit Post</title>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@picocss/pico@1/css/pico.classless.min.css"
    />
    <link href="/css/style.css" rel="stylesheet" />
  </head>
  <body>
    <main>
      <div class="authOptions">
        <h1>Edit Post</h1>
        <a role="button" href="/posts">Back to All Posts</a>
      </div>

      <form action="/posts/edit/<%= post.id %>" method="POST">
        <label>
          Title:
          <input
            type="text"
            name="title"
            value="<%= post.title %>"
            required
          />
        </label>

        <label>
          Link (optional):
          <input type="text" name="link" value="<%= post.link %>" />
        </label>

        <label>
          Description:
          <textarea name="description" required><%= post.description %></textarea>
        </label>

        <label>
          Subgroup:
          <input
            type="text"
            name="subgroup"
            value="<%= post.subgroup %>"
            required
          />
        </label>

        <button type="submit">Update Post</button>
      </form>
    </main>
  </body>
</html>
